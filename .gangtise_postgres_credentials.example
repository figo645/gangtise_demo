# Copy this file to .gangtise_postgres_credentials and replace the password.
# This file is intentionally safe to commit; the real file is gitignored.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=sprint_dashboard
APP_DB_USER=postgres
APP_DB_PASSWORD=replace_with_local_postgres_password

# Keep Staging bounded even if an accidental duplicate process is started.
# Production may retain the default 12 after load testing; this timeout only
# ends sessions that are idle while a transaction is still open.
DATABASE_POOL_MAX_CONNECTIONS=4
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

LOCAL_POSTGRES_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=sprint_dashboard
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=replace_with_local_postgres_password

VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
POSTGRES_DB=sprint_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_postgres_password
